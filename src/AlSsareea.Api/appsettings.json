{
  "ServiceInfo": {
    "Service": "AlSsareea.Backend",
    "ApiVersion": "1.0"
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SessionDays": 30,
    "Jwt": {
      "Issuer": "AlSsareea.Backend",
      "Audience": "AlSsareea.Clients",
      "SigningKey": "",
      "ClockSkewSeconds": 30
    },
    "PasswordHashing": {
      "Iterations": 210000,
      "SaltSize": 16,
      "HashSize": 32
    },
    "Lockout": {
      "MaximumFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "Otp": {
      "CodeLength": 6,
      "LifetimeMinutes": 5,
      "MaximumAttempts": 5,
      "ResendSeconds": 60,
      "Pepper": "",
      "DevelopmentProviderEnabled": false
    },
    "RateLimit": {
      "LoginPermitLimit": 10,
      "RefreshPermitLimit": 20,
      "OtpPermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Customers": {
    "MaxAddressesPerCustomer": 20,
    "DefaultLanguage": "ar",
    "DefaultCurrency": "ILS",
    "MaxDeliveryInstructionsLength": 1000,
    "AllowCustomerSelfProfileCreation": true
  },
  "Maps": {
    "Provider": "Fake",
    "Fake": {
      "FailAllRequests": false
    }
  },
  "ConnectionStrings": {
    "MerchantsDatabase": "",
    "CatalogDatabase": "",
    "MediaDatabase": "",
    "PricingDatabase": "",
    "CartsDatabase": "",
    "OrdersDatabase": "",
    "DriversDatabase": "",
    "TrackingDatabase": "",
    "DeliveryDatabase": "",
    "DispatchingDatabase": "",
    "NotificationsDatabase": ""
  },
  "Tracking": {
    "FutureToleranceSeconds": 30,
    "MaximumLiveStalenessSeconds": 300,
    "OfflineSyncWindowHours": 24,
    "MaximumBatchSize": 200,
    "IngestionPermitLimit": 240,
    "MaximumAccuracyMeters": 250,
    "MaximumPlausibleSpeedMetersPerSecond": 75,
    "OfflineIntervalSeconds": 120,
    "IdleIntervalSeconds": 30,
    "BusyIntervalSeconds": 10,
    "LocationHistoryRetentionDays": 30,
    "MaximumHistoryRangeHours": 24,
    "MaximumHistoryPageSize": 100
  },
  "Dispatching": {
    "OfferLifetimeSeconds": 30,
    "MaximumAttempts": 3,
    "MaximumCandidateCount": 50,
    "MaximumLocationStalenessSeconds": 300,
    "MaximumLocationAccuracyMeters": 250
  },
  "Notifications": {
    "Processing": {
      "PollingSeconds": 5,
      "BatchSize": 50,
      "DeliveryLimitPerMinute": 120,
      "MaximumBackoffSeconds": 900,
      "ProcessingLeaseSeconds": 300
    },
    "Providers": {
      "Fcm": {
        "Enabled": false,
        "TokenUri": "https://oauth2.googleapis.com/token",
        "TimeoutSeconds": 30
      },
      "Apns": {
        "Enabled": false,
        "UseSandbox": false,
        "TimeoutSeconds": 30
      }
    }
  },
  "Carts": {
    "ActiveCartLifetime": "30.00:00:00",
    "MaximumItems": 100,
    "MaximumQuantityPerItem": 99,
    "MaximumItemNoteLength": 500,
    "MaximumCouponCodeLength": 64,
    "MaximumIdempotencyKeyLength": 200
  },
  "Media": {
    "StorageRoot": "App_Data/media",
    "PublicBasePath": "/api/media/assets",
    "MaximumUploadBytes": 10485760,
    "MaximumWidth": 8000,
    "MaximumHeight": 8000,
    "MaximumPixels": 40000000,
    "ThumbnailSize": 160,
    "SmallSize": 480,
    "MediumSize": 960,
    "LargeSize": 1600,
    "WebPQuality": 82,
    "TemporaryRetentionHours": 24,
    "FailedRetentionDays": 7,
    "CleanupBatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
