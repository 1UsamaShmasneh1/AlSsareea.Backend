{
  "ServiceInfo": {
    "Service": "AlSsareea.Backend",
    "ApiVersion": "1.0"
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SessionDays": 30,
    "Jwt": {
      "Issuer": "AlSsareea.Backend",
      "Audience": "AlSsareea.Clients",
      "SigningKey": "",
      "ClockSkewSeconds": 30
    },
    "PasswordHashing": {
      "Iterations": 210000,
      "SaltSize": 16,
      "HashSize": 32
    },
    "Lockout": {
      "MaximumFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "Otp": {
      "CodeLength": 6,
      "LifetimeMinutes": 5,
      "MaximumAttempts": 5,
      "ResendSeconds": 60,
      "Pepper": "",
      "DevelopmentProviderEnabled": false
    },
    "RateLimit": {
      "LoginPermitLimit": 10,
      "RefreshPermitLimit": 20,
      "OtpPermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Customers": {
    "MaxAddressesPerCustomer": 20,
    "DefaultLanguage": "ar",
    "DefaultCurrency": "ILS",
    "MaxDeliveryInstructionsLength": 1000,
    "AllowCustomerSelfProfileCreation": true
  },
  "Maps": {
    "Provider": "Fake",
    "Fake": {
      "FailAllRequests": false
    }
  },
  "ConnectionStrings": {
    "MerchantsDatabase": "",
    "CatalogDatabase": "",
    "MediaDatabase": ""
  },
  "Media": {
    "StorageRoot": "App_Data/media",
    "PublicBasePath": "/api/media/assets",
    "MaximumUploadBytes": 10485760,
    "MaximumWidth": 8000,
    "MaximumHeight": 8000,
    "MaximumPixels": 40000000,
    "ThumbnailSize": 160,
    "SmallSize": 480,
    "MediumSize": 960,
    "LargeSize": 1600,
    "WebPQuality": 82,
    "TemporaryRetentionHours": 24,
    "FailedRetentionDays": 7,
    "CleanupBatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
